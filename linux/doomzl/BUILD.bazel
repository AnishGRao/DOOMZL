load("@rules_cc//cc:defs.bzl", "cc_library")

# Our doom additions.
cc_library(
    name = "doomzl",
    srcs = glob([
        "*.cc"
    ]),
    hdrs = glob([
        "*.h"
    ]),
    copts = [
        "-Wall",
    ],
    linkopts = [
        "-lXext",
        "-lX11",
        "-lm"
    ],
    defines = [
        "NORMALUNIX",
        "LINUX"
    ],
    visibility = ["//visibility:public"],
)